#!/bin/bash
# helper-start — запускает облачного помощника в MAIN-HOUSE, окно auto-инкремент.
# До PageDown включительно (курсor на последней видимой строке cloud-списка).

set -e

# --- 1. Найти следующий свободный номер ---
NEXT=1
while tmux list-windows -t MAIN-HOUSE -F '#{window_name}' 2>/dev/null | grep -q "helper_${NEXT}"; do
    NEXT=$((NEXT + 1))
done
T="MAIN-HOUSE:helper_${NEXT}"

# --- 2. Создать окно и запустить ollama TUI → cloud-фильтр ---
tmux new-window -t MAIN-HOUSE -n "helper_${NEXT}"
sleep 0.3
tmux send-keys -t $T "ollama"
sleep 2
tmux send-keys -t $T C-m       # Enter — запустить ollama
sleep 3
tmux send-keys -t $T Right     # стрелка вправо (навигация по TUI)
sleep 1.5
tmux send-keys -t $T "cloud"   # фильтр cloud

# --- 3. Подождать пока отобразится список cloud-моделей ---
for i in $(seq 1 8); do
    OUT=$(tmux capture-pane -pt $T | grep -v '^[[:space:]]*$')
    [ -n "$OUT" ] && break
    sleep 1
done

# --- 4. PageDown — курсор на последнюю видимую строку списка ---
tmux send-keys -t $T PageDown
sleep 0.5

echo "helper_${NEXT} готов: $T (курсор после PageDown)"
echo "--- кадр ---"
tmux capture-pane -pt $T | grep -v '^[[:space:]]*$'
