# ollama create qwen3-cod-NEXT-vb-no-promt:latest -f Modelfile_assistant_qwen3-cod-NEXT-vb-no-promt
# 1. Указываем базовую модель (имя должно совпадать с `ollama list`)
FROM qwen3-coder-next

# Низкая температура — минимум галлюцинаций, предсказуемый вывод
PARAMETER temperature 0.1

# Ограничиваем случайность выборки
PARAMETER top_p 0.2

# Увеличено с 5 до 20: при top_k=5 модель «застревает» на одном токене,
# 20 даёт достаточный запас без потери детерминизма
PARAMETER top_k 20


#PARAMETER num_ctx 2048
PARAMETER num_ctx 4096
#PARAMETER num_ctx 8192
#PARAMETER num_ctx 16384
#PARAMETER num_ctx 32768
#PARAMETER num_ctx 65536
#PARAMETER num_ctx 131072

# Максимальная длина ответа: 4096 токенов (~12k символов).
# Достаточно для конспекта 30–50 % объёма статьи, без бесконечного цикла
#PARAMETER num_predict 4096

